# Ghostty config
# Font
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 14

# window-padding-balance = true

theme = Everforest Dark Hard
background = #272E33

background-opacity = .98
background-blur = true

# window-decoration = none
# macos-titlebar-style = hidden

window-padding-y = 10,0

confirm-close-surface = false

# window-padding-color = extend

selection-foreground = #2d353b
selection-background = #543a48

# Colours: only where they differ from the theme (0, 7 and the brights 8-15, which the theme makes pale)
palette = 0=#4b565c
palette = 8=#7a8478

#-- Red
palette = 9=#e67e80

#-- Green
palette = 10=#a7c080

#-- Yellow
palette = 11=#dbbc7f

#-- Blue
palette = 12=#7fbbb3

#-- Magenta
palette = 13=#d699b6

#-- Cyan
palette = 14=#83c092

#-- White
palette = 7=#d3c6aa
palette = 15=#e2e2aa

macos-option-as-alt = left
